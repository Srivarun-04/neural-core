# ==========================================
# NuraVault Backend Environment Configuration
# ==========================================

# OpenRouter API Key for LLM Inference (Required)
# Get a key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Server Configuration (Optional - Defaults to 0.0.0.0:8000)
HOST=0.0.0.0
PORT=8000

# Allowed CORS Origins (Comma-separated for frontend clients)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# RAG Pipeline & Embedding Model Settings (Optional)
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=300
CHUNK_OVERLAP=50
RETRIEVAL_K=3
LLM_MODEL=openrouter/free
MEMORY_MAX_MESSAGES=10
